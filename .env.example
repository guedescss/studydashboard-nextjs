DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@[REGION].pooler.supabase.com:5432/postgres"

# Vercel + Supabase:
# Use the Supabase Transaction Pooler URL in DATABASE_URL for the deployed app.
# Use the Supabase Session Pooler URL in DIRECT_URL for Prisma migrations.
# The direct db.[PROJECT_REF].supabase.co:5432 URL can work locally, but it is IPv6-only
# and commonly fails from Vercel serverless functions.
